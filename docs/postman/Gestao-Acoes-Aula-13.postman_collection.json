{
  "info": {
    "_postman_id": "0fd2ef62-a9ad-46b4-aea9-55a6e7fa1300",
    "name": "Gestão de Ações — Aula 13 JWT",
    "description": "Cenários manuais de autenticação JWT e autorização USER/ADMIN. Use somente em ambiente isolado. Nenhuma requisição destrutiva é executada automaticamente; os DELETE administrativos possuem travas por variáveis de confirmação.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Cadastro de USER",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Postman\",\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Cria exclusivamente perfil USER. Execute em banco isolado e somente se o e-mail ainda não existir."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Cadastro retorna 201', () => pm.response.to.have.status(201));",
                "if (pm.response.code === 201) {",
                "  const json = pm.response.json();",
                "  pm.test('Cadastro público cria USER', () => pm.expect(json.usuario.perfil).to.eql('USER'));",
                "  pm.test('Resposta não expõe senha ou hash', () => pm.expect(pm.response.text()).not.to.match(/senha|hash/i));",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login de USER",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login USER retorna 200', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const json = pm.response.json();",
                "  pm.test('Perfil retornado é USER', () => pm.expect(json.usuario.perfil).to.eql('USER'));",
                "  pm.test('Tipo do token é Bearer', () => pm.expect(json.tipo).to.eql('Bearer'));",
                "  pm.environment.set('userToken', json.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login de ADMIN",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "A conta ADMIN deve ter sido criada pelo bootstrap seguro do profile dev ou preparada no ambiente isolado."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login ADMIN retorna 200', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const json = pm.response.json();",
                "  pm.test('Perfil retornado é ADMIN', () => pm.expect(json.usuario.perfil).to.eql('ADMIN'));",
                "  pm.environment.set('adminToken', json.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login com senha inválida — 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"senha-intencionalmente-incorreta\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Credenciais inválidas retornam 401', () => pm.response.to.have.status(401));",
                "pm.test('Resposta usa Problem Detail', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "2. JWT e rotas protegidas",
      "item": [
        {
          "name": "GET /auth/me — USER",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('/auth/me retorna 200', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const json = pm.response.json();",
                "  pm.test('Usuário autenticado é USER', () => pm.expect(json.perfil).to.eql('USER'));",
                "  pm.test('Não retorna senha ou hash', () => pm.expect(pm.response.text()).not.to.match(/senha|hash/i));",
                "}"
              ]
            }
          }]
        },
        {
          "name": "GET autenticado de recurso de negócio",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acoes?page=0&size=5&sort=ticker,asc",
            "description": "Consulta paginada real de ações com JWT de USER."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Recurso autenticado retorna 200', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Acesso sem JWT — 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acoes"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Ausência de JWT retorna 401', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "JWT adulterado — 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.environment.get('userToken');",
                  "if (!token) { throw new Error('Execute primeiro o Login de USER.'); }",
                  "const partes = token.split('.');",
                  "if (partes.length !== 3 || !partes[2]) { throw new Error('userToken não possui formato JWT.'); }",
                  "partes[2] = (partes[2][0] === 'a' ? 'b' : 'a') + partes[2].slice(1);",
                  "pm.variables.set('tamperedToken', partes.join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('JWT adulterado retorna 401', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tamperedToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acoes"
          }
        },
        {
          "name": "JWT expirado — 401",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('expiredToken')) { throw new Error('Defina expiredToken com um JWT realmente expirado conforme a descrição.'); }"] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('JWT expirado retorna 401', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{expiredToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acoes",
            "description": "Em ambiente isolado, configure temporariamente JWT_EXPIRATION_MINUTES=1, reinicie, faça login, aguarde a expiração e copie o token para expiredToken. Não versionar o valor."
          }
        }
      ]
    },
    {
      "name": "3. Autorização de DELETE",
      "description": "Use IDs preparados somente em ambiente isolado. A coleção não cria corretoras nem dispara exclusões automaticamente.",
      "item": [
        {
          "name": "USER tentando DELETE de corretora — 403",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('corretoraId')) { throw new Error('Defina corretoraId no ambiente isolado.'); }"] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('USER recebe 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/corretoras/{{corretoraId}}",
            "description": "O backend deve negar antes de executar a exclusão. Confirme depois que o registro permanece."
          }
        },
        {
          "name": "ADMIN tentando excluir corretora em uso — 409",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('confirmDeleteTests') !== 'SIM') { throw new Error('Defina confirmDeleteTests=SIM somente no ambiente isolado.'); }",
                  "if (!pm.environment.get('corretoraEmUsoId')) { throw new Error('Defina corretoraEmUsoId com uma corretora vinculada a transações.'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Corretora em uso retorna 409', () => pm.response.to.have.status(409));",
                  "if (pm.response.code === 409) { pm.test('Problem Detail identifica o conflito', () => pm.expect(pm.response.json().type).to.include('corretora-em-uso')); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/corretoras/{{corretoraEmUsoId}}",
            "description": "O ID deve pertencer a uma corretora com operações. Se o dado estiver preparado incorretamente, a API poderá excluir; por isso há uma trava explícita."
          }
        },
        {
          "name": "ADMIN excluindo corretora livre — 204",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('confirmDelete') !== 'SIM') { throw new Error('Exclusão bloqueada: defina confirmDelete=SIM somente para a corretora descartável em ambiente isolado.'); }",
                  "if (!pm.environment.get('corretoraLivreId')) { throw new Error('Defina corretoraLivreId com o ID descartável.'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ADMIN exclui corretora livre com 204', () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) {",
                  "  pm.environment.set('confirmDelete', '');",
                  "  pm.environment.set('corretoraLivreId', '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/corretoras/{{corretoraLivreId}}",
            "description": "DESTRUTIVO. Crie antes uma corretora descartável sem operações em banco isolado. A trava confirmDelete=SIM impede execução acidental no Collection Runner."
          }
        },
        {
          "name": "ADMIN tentando excluir ID inexistente — 404",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["if (!pm.environment.get('corretoraInexistenteId')) { throw new Error('Defina corretoraInexistenteId com um ID confirmado como inexistente.'); }"] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('ID inexistente retorna 404', () => pm.response.to.have.status(404));"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/corretoras/{{corretoraInexistenteId}}",
            "description": "Confirme no ambiente isolado que o ID informado realmente não existe."
          }
        }
      ]
    }
  ]
}
