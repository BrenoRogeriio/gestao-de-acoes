SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/gestao_acoes
DB_USERNAME=postgres
DB_PASSWORD=change-me

POSTGRES_DB=gestao_acoes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
APP_PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

BRAPI_TOKEN=insira-seu-token-brapi
TWELVE_DATA_API_KEY=insira-sua-chave-twelve-data

EXTERNAL_API_CONNECT_TIMEOUT_MS=3000
EXTERNAL_API_READ_TIMEOUT_MS=5000

# Gere um segredo com pelo menos 32 bytes e configure-o somente no .env local.
JWT_SECRET=
JWT_ISSUER=gestao-acoes
JWT_EXPIRATION_MINUTES=480

# Bootstrap opcional, somente no profile dev. Configure as duas variáveis ou deixe ambas vazias.
# APP_ADMIN_USERNAME deve ser um e-mail válido. A senha deve ter 12 a 72 caracteres, sem espaços,
# com letras maiúsculas e minúsculas, número e caractere especial.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# Usado somente pelo profile prod; mantenha false salvo decisão operacional explícita.
SWAGGER_ENABLED=false
